{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Auxiliary worker: the integration gateway (workers/integrations). Embeds
  // the Executor SDK and owns every upstream API credential; the app and audit
  // workers reach it only through the INTEGRATIONS service binding.
  // Must live at the repo root: wrangler resolves .dev.vars relative to this
  // file's directory, so a nested config would never see local secrets.
  "name": "open-seo-integrations",
  "main": "workers/integrations/src/index.ts",
  "workers_dev": false,
  // Match the main worker's runtime exactly.
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  // Same D1 as the app: Executor's tables (integration, connection, tool,
  // definition, ...) share it. workers/integrations/src/executor.ts asserts
  // the two table sets stay disjoint at startup. Mirror any resource-id edits
  // from wrangler.jsonc here too; miniflare derives local storage from them.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-seo",
      "database_id": "37bee90a-e1aa-404f-b01e-b0d1d479bda1",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "bucket_name": "open-seo",
      "binding": "R2",
    },
  ],
}
